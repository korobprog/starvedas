generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CURATOR
  STATISTICIAN
  CLIENT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  WAITING_PAYMENT_VERIFICATION
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  ASSIGNED
  IN_WORK
  WAITING_CLIENT
  WAITING_PAYMENT
  WAITING_PAYMENT_VERIFICATION
  PAID
  COMPLETED
  LOST
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum ClientFunnelStatus {
  VISITED
  STARTED_CHECKOUT
  DID_NOT_BUY
  BOUGHT
}

enum PriceUnit {
  PER_ORDER
  PER_PARTICIPANT
  PER_NAME
}

enum SellerType {
  IP
  OOO
  SELF_EMPLOYED
  OTHER
}

enum LegalDocumentType {
  PRIVACY
  PERSONAL_DATA_CONSENT
  OFFER
  PAYMENT_TERMS
  REFUND_TERMS
  CONTACTS
  PAYMENT_SECURITY
}

enum ParticipantChangeAction {
  UPDATED
}

enum ParticipantListStatus {
  NEW
  IN_WORK
  NEEDS_CLARIFICATION
  CHECKED
  READY_TO_SEND
  SENT
  ARCHIVED
}

enum ParticipantRowStatus {
  NEW
  CHECKED
  ERROR
  DUPLICATE
  UPDATED
  EXCLUDED
}

enum ParticipantListMessageRole {
  CURATOR
  STATISTICIAN
  ADMIN
  SYSTEM
}

enum PartnerApplicationType {
  IP
  SELF_EMPLOYED
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CLIENT)
  active       Boolean  @default(true)
  telegramId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curator                     Curator?
  clientProfile               ClientProfile?
  changedStatuses             LeadStatusHistory[]
  changedParticipants         ParticipantChangeHistory[]
  createdOrderRevisions       OrderRevision[]
  deletedOrders               Order[]                    @relation("OrderDeletedBy")
  reviewedPartnerApplications CuratorPartnerApplication[]
  participantListChanges      ParticipantListChange[]
  participantListMessages     ParticipantListMessage[]
}

model Curator {
  id                         String   @id @default(cuid())
  name                       String
  slug                       String   @unique
  active                     Boolean  @default(true)
  hidden                     Boolean  @default(false)
  isSystem                   Boolean  @default(false)
  sortOrder                  Int      @default(0)
  description                String?
  photoUrl                   String?
  postPurchaseTitle          String?
  postPurchaseText           String?
  postPurchaseUrl            String?
  supportButtonLabel         String?
  supportEnabled             Boolean  @default(true)
  supportUrl                 String?
  telegramId                 String?  @unique
  showMailingConsentCheckbox Boolean  @default(false)
  canEditPostPurchase        Boolean  @default(true)
  canEditSupport             Boolean  @default(true)
  canViewClients             Boolean  @default(true)
  userId                     String?  @unique
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  clients            ClientProfile[]
  clientEvents       ClientEvent[]
  orders             Order[]
  referralLinks      ReferralLink[]
  paymentOptions     CuratorPaymentOption[]
  partnerApplication CuratorPartnerApplication?
}

model CuratorPartnerApplication {
  id                  String                   @id @default(cuid())
  type                PartnerApplicationType
  status              PartnerApplicationStatus @default(PENDING)
  fullName            String
  inn                 String
  ogrnip              String?
  registrationAddress String?
  phone               String
  email               String?
  bankDetails         String?
  comment             String?
  rulesAccepted       Boolean                  @default(false)
  adminComment        String?
  reviewedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  curatorId    String  @unique
  reviewedById String?

  curator    Curator @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model ReferralLink {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String?
  active           Boolean  @default(true)
  isPrimary        Boolean  @default(false)
  createdByCurator Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  curatorId String
  curator   Curator @relation(fields: [curatorId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([curatorId])
  @@index([curatorId, createdByCurator])
}

model Service {
  id                           String    @id @default(cuid())
  title                        String
  titleEn                      String?
  titleHi                      String?
  slug                         String    @unique
  description                  String?
  descriptionEn                String?
  descriptionHi                String?
  detailsContent               String?
  detailsContentEn             String?
  detailsContentHi             String?
  receiptName                  String?
  vatTaxType                   Int       @default(0)
  priceRub                     Int
  priceUsd                     Int?
  priceInr                     Int?
  priceUnit                    PriceUnit @default(PER_PARTICIPANT)
  requiresExactParticipantList Boolean   @default(true)
  isSubscription               Boolean   @default(false)
  subscriptionStartsAt         DateTime?
  subscriptionEndsAt           DateTime?
  vedicGiftEnabled             Boolean   @default(false)
  vedicGiftTitle               String?
  vedicGiftDescription         String?
  shraddhaModeEnabled          Boolean   @default(false)
  shraddhaWarningText          String?
  shraddhaUnbornLabel          String?
  shraddhaDeceasedChildLabel   String?
  shraddhaChildHelpText        String?
  active                       Boolean   @default(true)
  sortOrder                    Int       @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  orders     Order[]
  orderItems OrderItem[]
  options    ServiceOption[]
}

model ServiceOption {
  id            String    @id @default(cuid())
  title         String
  titleEn       String?
  titleHi       String?
  description   String?
  descriptionEn String?
  descriptionHi String?
  priceRub      Int
  priceUsd      Int?
  priceInr      Int?
  priceUnit     PriceUnit @default(PER_PARTICIPANT)
  active        Boolean   @default(true)
  eventStartsAt DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  orderItems OrderServiceOption[]

  @@index([serviceId, active, eventStartsAt, sortOrder])
  @@index([serviceId, active, sortOrder])
}

model Schedule {
  id        String   @id @default(cuid())
  month     String
  title     String
  body      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id            String    @id @default(cuid())
  title         String
  titleEn       String?
  titleHi       String?
  slug          String    @unique
  excerpt       String?
  excerptEn     String?
  excerptHi     String?
  content       String
  contentEn     String?
  contentHi     String?
  coverImageUrl String?
  active        Boolean   @default(false)
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, publishedAt, sortOrder])
}

model ClientProfile {
  id                    String             @id @default(cuid())
  name                  String
  telegram              String?
  telegramId            String?            @unique
  telegramFirstName     String?
  telegramLastName      String?
  telegramPhotoUrl      String?
  telegramAuthDate      DateTime?
  phone                 String?
  email                 String?
  consentPersonalData   Boolean            @default(false)
  consentMailings       Boolean            @default(false)
  consentMailingsAt     DateTime?
  consentMailingsSource String?
  status                ClientFunnelStatus @default(VISITED)
  source                String             @default("site")
  sourceDomain          String             @default("starvedas.ru")
  referralSlug          String?
  lastVisitedAt         DateTime?
  checkoutStartedAt     DateTime?
  didNotBuyAt           DateTime?
  boughtAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  curatorId String?
  userId    String? @unique

  curator           Curator?           @relation(fields: [curatorId], references: [id], onDelete: SetNull)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  events            ClientEvent[]
  orders            Order[]
  savedParticipants SavedParticipant[]

  @@index([telegram])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([sourceDomain])
  @@index([consentMailings])
  @@index([curatorId])
  @@index([updatedAt])
}

model SavedParticipant {
  id        String   @id @default(cuid())
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, fullName])
  @@index([clientId])
}

model ClientEvent {
  id           String             @id @default(cuid())
  status       ClientFunnelStatus
  source       String             @default("site")
  referralSlug String?
  visitorId    String?
  createdAt    DateTime           @default(now())

  clientId  String?
  curatorId String?

  client  ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  curator Curator?       @relation(fields: [curatorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([visitorId])
  @@index([clientId])
  @@index([curatorId])
  @@index([createdAt])
}

model Order {
  id                           String      @id @default(cuid())
  orderNumber                  Int         @unique @default(autoincrement())
  status                       OrderStatus @default(DRAFT)
  leadStatus                   LeadStatus  @default(NEW)
  participantCount             Int
  participantsText             String
  amountRub                    Int
  currency                     String      @default("RUB")
  customerName                 String
  customerTelegram             String?
  customerPhone                String?
  customerEmail                String?
  consentPersonalData          Boolean     @default(false)
  publicToken                  String      @unique
  source                       String      @default("site")
  sourceDomain                 String      @default("starvedas.ru")
  referralSlug                 String?
  isSubscriptionSnapshot       Boolean     @default(false)
  subscriptionStartsAtSnapshot DateTime?
  subscriptionEndsAtSnapshot   DateTime?
  isMultiItem                  Boolean     @default(false)
  createdAt                    DateTime    @default(now())
  deletedAt                    DateTime?
  deleteReason                 String?
  updatedAt                    DateTime    @updatedAt

  curatorId String
  serviceId String
  clientId  String?
  deletedById String?

  curator         Curator              @relation(fields: [curatorId], references: [id], onDelete: Restrict)
  service         Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client          ClientProfile?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deletedBy       User?                @relation("OrderDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  items           OrderItem[]
  participants    OrderParticipant[]
  childRecords    OrderChildRecord[]
  serviceOptions  OrderServiceOption[]
  payment         Payment?
  revisions       OrderRevision[]
  statusHistory   LeadStatusHistory[]
  participantList ParticipantList?
  vedicGiftData   VedicGiftData?

  @@index([sourceDomain])
  @@index([referralSlug])
  @@index([deletedAt, updatedAt])
  @@index([deletedById, deletedAt])
}

model OrderItem {
  id                           String    @id @default(cuid())
  sortOrder                    Int       @default(0)
  titleSnapshot                String
  priceRubSnapshot             Int
  priceUnitSnapshot            PriceUnit @default(PER_PARTICIPANT)
  currencySnapshot             String    @default("RUB")
  vatTaxTypeSnapshot           Int       @default(0)
  receiptNameSnapshot          String?
  isSubscriptionSnapshot       Boolean   @default(false)
  subscriptionStartsAtSnapshot DateTime?
  subscriptionEndsAtSnapshot   DateTime?
  participantCount             Int       @default(0)
  participantsText             String    @default("")
  amountRub                    Int
  createdAt                    DateTime  @default(now())

  orderId   String
  serviceId String

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service        Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  participants   OrderParticipant[]
  childRecords   OrderChildRecord[]
  serviceOptions OrderServiceOption[]

  @@index([orderId, sortOrder])
  @@index([serviceId])
}

enum ChildRecordType {
  UNBORN
  DECEASED
}

model OrderChildRecord {
  id          String          @id @default(cuid())
  type        ChildRecordType
  parentName  String
  childCount  Int
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  orderId     String
  orderItemId String?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
}

model OrderServiceOption {
  id                  String    @id @default(cuid())
  titleSnapshot       String
  serviceTitleSnapshot String?
  descriptionSnapshot String?
  priceRubSnapshot    Int
  priceUnitSnapshot   PriceUnit @default(PER_PARTICIPANT)
  quantitySnapshot    Int       @default(1)
  totalRubSnapshot    Int
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())

  orderId     String
  orderItemId String?
  optionId    String?

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ServiceOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderId, sortOrder])
  @@index([orderItemId])
  @@index([optionId])
}

model OrderParticipant {
  id                  String               @id @default(cuid())
  fullName            String
  rowStatus           ParticipantRowStatus @default(NEW)
  statisticianComment String?
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orderId     String
  orderItemId String?
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?                 @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  history     ParticipantChangeHistory[]

  @@index([orderItemId])
}

model ParticipantList {
  id                   String                @id @default(cuid())
  status               ParticipantListStatus @default(NEW)
  bookmarked           Boolean               @default(false)
  serviceTitleOverride String?
  eventStartsAt        DateTime?
  note                 String?
  sentAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  changes  ParticipantListChange[]
  messages ParticipantListMessage[]

  @@index([status])
  @@index([bookmarked])
  @@index([eventStartsAt])
  @@index([updatedAt])
}

model ParticipantListMessage {
  id         String                     @id @default(cuid())
  body       String
  senderRole ParticipantListMessageRole
  createdAt  DateTime                   @default(now())

  listId   String
  senderId String?

  list   ParticipantList @relation(fields: [listId], references: [id], onDelete: Cascade)
  sender User?           @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([listId, createdAt])
  @@index([senderId])
}

model ParticipantListChange {
  id        String   @id @default(cuid())
  fieldName String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  listId      String
  changedById String?

  list      ParticipantList @relation(fields: [listId], references: [id], onDelete: Cascade)
  changedBy User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([listId, createdAt])
  @@index([changedById])
}

model Payment {
  id                String        @id @default(cuid())
  provider          String        @default("prodamus")
  amountRub         Int
  currency          String        @default("RUB")
  status            PaymentStatus @default(PENDING)
  providerPaymentId String?
  paymentUrl        String?
  receiptUrl        String?
  receiptLabel      String?
  receiptUploadedAt DateTime?
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderRevision {
  id               String   @id @default(cuid())
  eventType        String
  note             String?
  snapshot         Json
  sourceRevisionId String?
  createdAt        DateTime @default(now())

  orderId      String
  actorUserId  String?

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

model AccountingReport {
  id                    String    @id @default(cuid())
  sourceDomain          String    @unique
  spreadsheetId         String?
  spreadsheetUrl        String?
  accountantEmail       String?
  lastSyncedAt          DateTime?
  lastSyncStatus        String    @default("NEVER")
  lastSyncError         String?
  lastSyncedPeriodStart DateTime?
  lastSyncedPeriodEnd   DateTime?
  operationCount        Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  syncLogs AccountingSyncLog[]

  @@index([sourceDomain])
}

model AccountingSyncLog {
  id             String    @id @default(cuid())
  sourceDomain   String
  status         String
  message        String?
  rowsAdded      Int       @default(0)
  rowsUpdated    Int       @default(0)
  operationCount Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  reportId String?
  report   AccountingReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([sourceDomain, startedAt])
  @@index([reportId])
}

model OrganizationSettings {
  id                                String     @id @default(cuid())
  sellerType                        SellerType @default(IP)
  legalName                         String?
  directorName                      String?
  inn                               String?
  ogrn                              String?
  legalAddress                      String?
  postalAddress                     String?
  clientEmail                       String?
  clientPhone                       String?
  officialTelegram                  String?
  supportHours                      String?
  bankDetails                       String?
  publicRecipientName               String?
  cashboxDetails                    String?
  allowCuratorManageServices        Boolean    @default(false)
  hideChintamaniAdminSupportButtons Boolean    @default(false)
  partnerProgramAgreementText       String?
  createdAt                         DateTime   @default(now())
  updatedAt                         DateTime   @updatedAt
}

model PaymentMethod {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  logoUrl     String?
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentProvider {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  supportedLocales String   @default("ru,en,hi")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  curatorOptions CuratorPaymentOption[]
}

model CuratorPaymentOption {
  id                 String   @id @default(cuid())
  providerCode       String
  allowed            Boolean  @default(false)
  enabled            Boolean  @default(false)
  instructions       String?
  bankName           String?
  recipientName      String?
  accountNumber      String?
  phone              String?
  paymentComment     String?
  verificationPeriod String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  curatorId String
  curator   Curator         @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  provider  PaymentProvider @relation(fields: [providerCode], references: [code], onDelete: Cascade)

  @@unique([curatorId, providerCode])
  @@index([providerCode])
}

model LegalDocument {
  id        String            @id @default(cuid())
  type      LegalDocumentType
  title     String
  slug      String            @unique
  content   String
  version   String            @default("1.0")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  fromStatus LeadStatus?
  toStatus   LeadStatus
  note       String?
  createdAt  DateTime    @default(now())

  orderId     String
  changedById String?

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)
}

model ParticipantChangeHistory {
  id           String                  @id @default(cuid())
  action       ParticipantChangeAction @default(UPDATED)
  fromFullName String?
  toFullName   String?
  note         String?
  createdAt    DateTime                @default(now())

  participantId String
  changedById   String?

  participant OrderParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  changedBy   User?            @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([changedById])
}

model VedicGiftData {
  id               String   @id @default(cuid())
  lastName         String
  firstName        String
  email            String
  birthDate        DateTime
  birthTime        String?
  birthTimeUnknown Boolean  @default(false)
  phone            String?
  telegram         String?
  notes            String?
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([processed])
  @@index([createdAt])
}
